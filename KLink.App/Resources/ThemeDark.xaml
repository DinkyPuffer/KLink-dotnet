<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 覆盖 WPF UI 主题色 = Java 版翡翠配色 ============ -->
    <Color x:Key="SystemAccentColor">#9ED9CC</Color>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#9ED9CC" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B8F0E4" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#6A9E92" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6A9E92" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9ED9CC" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8F0E4" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3A4A45" />
    <SolidColorBrush x:Key="AccentStrokeColorDefaultBrush" Color="#9ED9CC" />

    <!-- 背景层级（Java 版） -->
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#0A0A0F" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#0A0A0F" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#14141C" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#1A1A24" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#1A1A24" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#14141C" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#0E0E14" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2A2A36" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#33333F" />

    <!-- 文字层级（Java 版） -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECECF0" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A0A0B0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#606070" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#40404C" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#050508" />

    <Color x:Key="Color.EmeraldStrong">#B8F0E4</Color>
    <Color x:Key="Color.Emerald">#9ED9CC</Color>
    <Color x:Key="Color.EmeraldMuted">#6A9E92</Color>
    <Color x:Key="Color.Danger">#E05252</Color>
    <Color x:Key="Color.DangerStrong">#E8685C</Color>
    <SolidColorBrush x:Key="Brush.DangerTint" Color="#26C05040" />

    <!-- ============ 自用语义键 ============ -->
    <SolidColorBrush x:Key="Brush.Emerald" Color="#8CC9BA" />
    <SolidColorBrush x:Key="Brush.EmeraldStrong" Color="#A8E0D2" />
    <SolidColorBrush x:Key="Brush.EmeraldMuted" Color="#5E8A80" />
    <SolidColorBrush x:Key="Brush.BgDeep" Color="#0F0F12" />
    <SolidColorBrush x:Key="Brush.BgBase" Color="#141417" />
    <SolidColorBrush x:Key="Brush.BgSurface" Color="#18181C" />
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#1E1E24" />
    <SolidColorBrush x:Key="Brush.BgOverlay" Color="#26262E" />
    <!-- 现代卡片半透明背景（透出 Mica 毛玻璃） -->
    <SolidColorBrush x:Key="Brush.ModernCardBackground" Color="#E61E1E24" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#ECECF0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A6A6B2" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#686876" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E05252" />
    <SolidColorBrush x:Key="Brush.Success" Color="#6FCF7A" />

    <!-- 选中态 / 悬浮态色调 -->
    <SolidColorBrush x:Key="Brush.SelectionTint" Color="#1C322C" />
    <SolidColorBrush x:Key="Brush.HoverTint" Color="#14FFFFFF" />

    <!-- ============ 页面通用样式 ============ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============ 列表列头（深色，去掉默认白条） ============ -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
