<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色主题 = Java 版「Moon Light」预设配色 ============
         bgDeep #e8e4dc / bgBase #edeae3 / bgSurface #f2f0ea
         bgElevated #ece9e2 / bgOverlay #e5e1d8
         textPrimary #2a2822 / textSecondary #5e5b52 / textTertiary #8c887c
         accent #5c8a78（鼠尾草绿）/ danger #c05040 / success #4a8e60 -->

    <Color x:Key="SystemAccentColor">#5C8A78</Color>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#5C8A78" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#3D6B58" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8AB8A4" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8AB8A4" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5C8A78" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3D6B58" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#C4D8D0" />
    <SolidColorBrush x:Key="AccentStrokeColorDefaultBrush" Color="#5C8A78" />

    <!-- 背景层级 -->
    <SolidColorBrush x:Key="ApplicationBackgroundColorBrush" Color="#EDEAE3" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F2F0EA" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#EDEAE3" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#F2F0EA" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#ECE9E2" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#E5E1D8" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#ECE9E2" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E5E1D8" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E8E4DC" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D6D2C8" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#CBC6BB" />

    <!-- 文字层级 -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2A2822" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5E5B52" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8C887C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#BAB6AA" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

    <Color x:Key="Color.EmeraldStrong">#3D6B58</Color>
    <Color x:Key="Color.Emerald">#5C8A78</Color>
    <Color x:Key="Color.EmeraldMuted">#8AB8A4</Color>
    <Color x:Key="Color.Danger">#C05040</Color>
    <Color x:Key="Color.DangerStrong">#D45A48</Color>
    <SolidColorBrush x:Key="Brush.DangerTint" Color="#1AC05040" />

    <!-- ============ 自用语义键 ============ -->
    <SolidColorBrush x:Key="Brush.Emerald" Color="#5C8A78" />
    <SolidColorBrush x:Key="Brush.EmeraldStrong" Color="#3D6B58" />
    <SolidColorBrush x:Key="Brush.EmeraldMuted" Color="#8AB8A4" />
    <SolidColorBrush x:Key="Brush.BgDeep" Color="#E8E4DC" />
    <SolidColorBrush x:Key="Brush.BgBase" Color="#EDEAE3" />
    <SolidColorBrush x:Key="Brush.BgSurface" Color="#F2F0EA" />
    <SolidColorBrush x:Key="Brush.BgElevated" Color="#ECE9E2" />
    <SolidColorBrush x:Key="Brush.BgOverlay" Color="#E5E1D8" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#2A2822" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5E5B52" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8C887C" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C05040" />
    <SolidColorBrush x:Key="Brush.Success" Color="#4A8E60" />

    <!-- 选中态 / 悬浮态色调（浅色版：accent 8% 底 / 8% 黑） -->
    <SolidColorBrush x:Key="Brush.SelectionTint" Color="#E4EDE7" />
    <SolidColorBrush x:Key="Brush.HoverTint" Color="#14000000" />

    <!-- ============ 页面通用样式 ============ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============ 列表列头（与卡片同色） ============ -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.BgElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
