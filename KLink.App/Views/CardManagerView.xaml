<UserControl x:Class="KLink.App.Views.CardManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:glow="clr-namespace:KLink.App.Infrastructure"
             xmlns:animations="clr-namespace:KLink.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="1100">
    <Grid Margin="36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{DynamicResource PageTitle}" Text="卡牌管理" />
            <TextBlock Style="{DynamicResource HintText}" Margin="0,6,0,0"
                       Text="编辑卡牌库与卡组代码，保存后写入运行时覆盖文件，重启服务器生效" />
        </StackPanel>

        <!-- 数据文件路径 -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.BgElevated}" CornerRadius="12" Padding="20,14"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="卡牌库" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0" />
                <ui:TextBox x:Name="TxtLibraryPath" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" />
                <ui:Button x:Name="BtnBrowseLibrary" Grid.Row="0" Grid.Column="2" Content="浏览…"
                           Style="{DynamicResource SecondaryActionButton}" Padding="12,4" Margin="10,0,0,0"
                           Click="BrowseLibrary_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="卡组映射" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0" />
                <ui:TextBox x:Name="TxtDeckCodesPath" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" />
                <ui:Button x:Name="BtnBrowseDeckCodes" Grid.Row="2" Grid.Column="2" Content="浏览…"
                           Style="{DynamicResource SecondaryActionButton}" Padding="12,4" Margin="10,0,0,0"
                           Click="BrowseDeckCodes_Click" />
            </Grid>
        </Border>

        <!-- 两个表格页 -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.BgElevated}" CornerRadius="14" Padding="22,18"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- ===== 卡牌代码（library.json） ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="卡牌代码" />
                            <TextBlock x:Name="CardCountText" Style="{DynamicResource HintText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="删除选中" Style="{DynamicResource DangerOutlineButton}"
                                           Padding="14,6" Click="DeleteCards_Click" />
                                <ui:Button Content="添加 / 更新" glow:GlowSpotlight.Enabled="True"
                                           animations:ButtonAnimations.Enabled="True"
                                           Style="{DynamicResource PrimaryActionButton}" Icon="Add24"
                                           Padding="14,6" Margin="10,0,0,0" Click="EditCard_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <ui:TextBox x:Name="TxtCardSearch" Width="220" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ui:ListView x:Name="CardList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Extended">
                            <ui:ListView.View>
                                <GridView>
                                    <GridViewColumn Header="数字 ID" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="卡牌代码" Width="360">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CardType}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="数量" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Count}" Foreground="{DynamicResource Brush.TextTertiary}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                    </Grid>
                </TabItem>

                <!-- ===== 卡组代码（deck_code_ids.json） ===== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="卡组代码" />
                            <TextBlock x:Name="DeckCountText" Style="{DynamicResource HintText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Content="删除选中" Style="{DynamicResource DangerOutlineButton}"
                                           Padding="14,6" Click="DeleteDecks_Click" />
                                <ui:Button Content="添加 / 更新" glow:GlowSpotlight.Enabled="True"
                                           animations:ButtonAnimations.Enabled="True"
                                           Style="{DynamicResource PrimaryActionButton}" Icon="Add24"
                                           Padding="14,6" Margin="10,0,0,0" Click="EditDeck_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <ui:TextBox x:Name="TxtDeckSearch" Width="220" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ui:ListView x:Name="DeckList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                     SelectionMode="Extended">
                            <ui:ListView.View>
                                <GridView>
                                    <GridViewColumn Header="数字 ID" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="卡组代码" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="对应卡牌" Width="360">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Card}" Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ui:ListView.View>
                        </ui:ListView>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 操作按钮 + 日志 -->
        <Border Grid.Row="6" Background="{DynamicResource Brush.BgElevated}" CornerRadius="12" Padding="18,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="日志" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBox x:Name="LogBox" Grid.Column="2" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                             IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             MaxHeight="72" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Content="重新加载" Style="{DynamicResource SecondaryActionButton}"
                               Icon="ArrowClockwise24" Padding="14,6" Click="Reload_Click" />
                    <ui:Button Content="检查一致性" Style="{DynamicResource SecondaryActionButton}"
                               Icon="Checkmark24" Padding="14,6" Margin="8,0,0,0" Click="Check_Click" />
                    <ui:Button Content="保存全部修改" glow:GlowSpotlight.Enabled="True"
                               animations:ButtonAnimations.Enabled="True"
                               Style="{DynamicResource PrimaryActionButton}" Icon="Save24"
                               Padding="16,6" Margin="8,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
