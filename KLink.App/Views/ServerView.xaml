<UserControl x:Class="KLink.App.Views.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:glow="clr-namespace:KLink.App.Infrastructure"
             xmlns:animations="clr-namespace:KLink.App.Infrastructure"
             xmlns:services="clr-namespace:KLink.App.Services"
             mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="680" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- 模式选择卡片 -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
<Border x:Name="Bd" Background="{DynamicResource Brush.BgSurface}" CornerRadius="0" Padding="12,14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Cursor="Hand" MinHeight="86">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.EmeraldMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Emerald}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SelectionTint}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左列 ============ -->
        <StackPanel Grid.Column="0">
            <!-- 状态 Hero -->
<Border Style="{StaticResource ModernCard}" Padding="22,18">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26"
                            Background="{DynamicResource Brush.SelectionTint}" VerticalAlignment="Center">
                        <Ellipse x:Name="HeroDot" Width="16" Height="16"
                                 Fill="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Text="服务器未启动" />
                        <TextBlock x:Name="HeroSubtitle" Style="{DynamicResource HintText}" Margin="0,3,0,0"
                                   Text="选择运行模式并启动" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}">
                                <Run Text="模式 " /><Run x:Name="HeroMode" Text="本地" Foreground="{DynamicResource Brush.Emerald}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="16,0,0,0">
                                <Run Text="端口 " /><Run x:Name="HeroPort" Text="5231" Foreground="{DynamicResource Brush.Emerald}" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="16,0,0,0">
                                <Run Text="玩家 " /><Run x:Name="HeroPlayers" Text="0" Foreground="{DynamicResource Brush.Emerald}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 模式选择 -->
<Border Style="{StaticResource ModernCard}" Margin="0,14,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="运行模式" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ModeLocal" Grid.Column="0" Style="{DynamicResource ModeCard}"
                                     GroupName="Mode" IsChecked="True" Checked="Mode_Checked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="26"
                                               Foreground="{DynamicResource Brush.Emerald}" HorizontalAlignment="Center" />
                                <TextBlock Text="本地模式" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="自娱自乐" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeLan" Grid.Column="2" Style="{DynamicResource ModeCard}"
                                     GroupName="Mode" Checked="Mode_Checked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Globe24" FontSize="26"
                                               Foreground="{DynamicResource Brush.Emerald}" HorizontalAlignment="Center" />
                                <TextBlock Text="局域网模式" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="好友联机" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeRemote" Grid.Column="4" Style="{DynamicResource ModeCard}"
                                     GroupName="Mode" Checked="Mode_Checked">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Cloud24" FontSize="26"
                                               Foreground="{DynamicResource Brush.Emerald}" HorizontalAlignment="Center" />
                                <TextBlock Text="远程转发" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center" />
                                <TextBlock Text="连接远程服" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 远程地址（远程模式显示） -->
<Border x:Name="CardRemote" Style="{StaticResource ModernCard}" Margin="0,14,0,0" Padding="18,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="远程服务器地址" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtRemoteAddress" Grid.Column="0" PlaceholderText="IP 或域名" />
                        <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                        <ui:TextBox x:Name="TxtRemotePort" Grid.Column="2" Text="5231" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 房间设置 -->
<Border Style="{StaticResource ModernCard}" Margin="0,14,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="房间设置" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="房间名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" />
                        <ui:TextBox x:Name="TxtRoomName" Grid.Row="0" Grid.Column="1" Text="KLink Room" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="主机名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" />
                        <ui:TextBox x:Name="TxtHostName" Grid.Row="2" Grid.Column="1" Text="Host" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 控制按钮 -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ui:Button x:Name="BtnStartServer" glow:GlowSpotlight.Enabled="True" Style="{DynamicResource PrimaryActionButton}"
                           MinWidth="170" animations:ButtonAnimations.Enabled="True" Click="StartServer_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Play24" FontSize="16" />
                        <TextBlock x:Name="StartServerText" Text="启动服务器" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnStopServer" glow:GlowSpotlight.Enabled="True" Style="{DynamicResource DangerOutlineButton}"
                           MinWidth="150" Margin="12,0,0,0" IsEnabled="False"
                           animations:ButtonAnimations.Enabled="True" Click="StopServer_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="15" />
                        <TextBlock x:Name="StopServerText" Text="停止服务器" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
