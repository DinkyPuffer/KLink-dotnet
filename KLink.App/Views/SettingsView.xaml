<UserControl x:Class="KLink.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:glow="clr-namespace:KLink.App.Infrastructure"
             xmlns:animations="clr-namespace:KLink.App.Infrastructure"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{DynamicResource PageTitle}" Text="设置" />



            <!-- 外观 -->
<Border Style="{StaticResource ModernCard}" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="外观" />

                    <!-- 主题 -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="主题" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Width="64" />
                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="深色" IsChecked="True"
                                     Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"
                                     Checked="Theme_Changed" />
                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="浅色"
                                     Foreground="{DynamicResource Brush.TextPrimary}" Margin="20,0,0,0"
                                     VerticalAlignment="Center" Checked="Theme_Changed" />
                    </StackPanel>

                    <!-- 背景 -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="背景" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Width="64" />
                        <RadioButton x:Name="BgNone" GroupName="Bg" Content="无" IsChecked="True"
                                     Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"
                                     Checked="Bg_Changed" />
                        <RadioButton x:Name="BgImage" GroupName="Bg" Content="图片"
                                     Foreground="{DynamicResource Brush.TextPrimary}" Margin="20,0,0,0"
                                     VerticalAlignment="Center" Checked="Bg_Changed" />
                        <RadioButton x:Name="BgVideo" GroupName="Bg" Content="视频"
                                     Foreground="{DynamicResource Brush.TextPrimary}" Margin="20,0,0,0"
                                     VerticalAlignment="Center" Checked="Bg_Changed" />
                        <ui:Button x:Name="BtnPickBg" Content="选择文件…" Style="{DynamicResource SecondaryActionButton}"
                                   Padding="10,4" Margin="18,0,0,0" Click="PickBg_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtBgPath" Style="{DynamicResource HintText}" Margin="64,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- 游戏目录 -->
<Border Style="{StaticResource ModernCard}" Margin="0,20,0,0" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="游戏目录" />
                    <TextBlock x:Name="TxtDetectedRoot" Style="{DynamicResource HintText}" Margin="0,6,0,0" />


                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="TxtGameRoot" Width="420" VerticalContentAlignment="Center" />
                        <ui:Button x:Name="BtnBrowseRoot" glow:GlowSpotlight.Enabled="True" Content="浏览…" Style="{DynamicResource SecondaryActionButton}"
                                   Margin="8,0,0,0" Click="BrowseRoot_Click" />
                        <ui:Button x:Name="BtnResetRoot" glow:GlowSpotlight.Enabled="True" Content="恢复自动探测" Style="{DynamicResource SecondaryActionButton}"
                                   Margin="8,0,0,0" Click="ResetRoot_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 版本补丁（功能一） -->
<Border Style="{StaticResource ModernCard}" Margin="0,20,0,0" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="版本补丁" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="模板 pak" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Width="64" />
                        <ui:TextBox x:Name="TxtVersionPak" Width="420" VerticalContentAlignment="Center" />
                        <ui:Button x:Name="BtnBrowseVersionPak" glow:GlowSpotlight.Enabled="True" Content="浏览…" Style="{DynamicResource SecondaryActionButton}"
                                   Margin="8,0,0,0" Click="BrowseVersionPak_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="版本号" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" Width="64" />
                        <ui:TextBox x:Name="TxtGameVersion" Width="200" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 服务器配置 -->
<Border Style="{StaticResource ModernCard}" Margin="0,20,0,0" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="服务器配置" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="房间名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <ui:TextBox x:Name="TxtRoomName" Grid.Row="0" Grid.Column="1" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="主机名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <ui:TextBox x:Name="TxtHostName" Grid.Row="2" Grid.Column="1" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="默认玩家名" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <ui:TextBox x:Name="TxtPlayerName" />
                            <TextBlock Style="{DynamicResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="新玩家首次进入游戏时使用的显示名；留空则用服务端默认值。" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="管理员令牌" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <ui:TextBox x:Name="TxtAdminToken" Grid.Row="6" Grid.Column="1" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="管理员名称" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Grid.Row="8" Grid.Column="1">
                            <ui:TextBox x:Name="TxtAdminDisplayName" />
                            <TextBlock Style="{DynamicResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="后台管理界面右上角显示的名字；本机打开后台免登录。留空则用「管理员」。" />
                        </StackPanel>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="远程地址" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                            <ui:TextBox x:Name="TxtRemoteAddress" Width="280" VerticalContentAlignment="Center" />
                            <TextBlock Text="端口" Margin="10,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                            <ui:TextBox x:Name="TxtRemotePort" Width="80" VerticalContentAlignment="Center" />
                            <TextBlock Text="WS 端口" Margin="10,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                            <ui:TextBox x:Name="TxtRemoteWsPort" Width="80" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关于 -->
<Border Style="{StaticResource ModernCard}" Margin="0,20,0,0" Padding="24,20">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CardTitle}" Text="关于" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="制作者" VerticalAlignment="Center" Width="70"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock VerticalAlignment="Center">
                            <Hyperlink Tag="https://space.bilibili.com/3546971308559129" Click="OpenUrl_Click"
                                       Foreground="{DynamicResource Brush.EmeraldStrong}" TextDecorations="None"
                                       FontWeight="SemiBold">氧化铜依旧CuO</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="特别感谢" VerticalAlignment="Center" Width="70"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Tag="https://space.bilibili.com/1253227194" Click="OpenUrl_Click"
                                           Foreground="{DynamicResource Brush.EmeraldStrong}" TextDecorations="None"
                                           FontWeight="SemiBold">KardsWalker卡兹走路人</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="、" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Tag="https://space.bilibili.com/1180481405" Click="OpenUrl_Click"
                                           Foreground="{DynamicResource Brush.EmeraldStrong}" TextDecorations="None"
                                           FontWeight="SemiBold">末水的粉丝</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="、" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="DeepSeek" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.EmeraldStrong}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}">
                        本项目完全免费且在
                        <Hyperlink Tag="https://github.com/Xuewu-awa/KLink-dotnet" Click="OpenUrl_Click"
                                   Foreground="{DynamicResource Brush.EmeraldStrong}" TextDecorations="None"
                                   FontWeight="SemiBold">GitHub</Hyperlink>
                        开源
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <ui:Button x:Name="BtnSaveSettings" glow:GlowSpotlight.Enabled="True" animations:ButtonAnimations.Enabled="True" Content="保存设置" Style="{DynamicResource SecondaryActionButton}" Icon="Save24"
                           MinWidth="140" Click="SaveSettings_Click" />
                <TextBlock x:Name="TxtSaveHint" Style="{DynamicResource HintText}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
